{
  "name": "azat-io",
  "version": "1.0.0",
  "private": true,
  "description": "My personal website",
  "keywords": [
    "blog"
  ],
  "homepage": "https://azat.io",
  "repository": "azat-io/azat-io",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Azat S. <to@azat.io>",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "start": "astro dev",
    "test": "pnpm run /^test:/",
    "test:astro": "astro check",
    "test:css": "stylelint \"**/*.{astro,svelte,css}\"",
    "test:format": "prettier --check \"**/*.{js,ts,astro,css,json,md,yml}\"",
    "test:js": "eslint --concurrency auto .",
    "test:markdown": "remark \"**/*.{md,mdx}\" --frail",
    "test:packages": "pnpm dedupe --check",
    "test:size": "pnpm run build && size-limit",
    "test:spelling": "cspell --config cspell.config.ts \"**/*\"",
    "test:svelte": "svelte-check",
    "test:types": "tsc --noEmit --pretty",
    "test:usage": "knip"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@kindspells/astro-shield": "^1.7.1",
    "@playform/compress": "^0.2.5",
    "@poppanator/sveltekit-svg": "^7.0.1",
    "@vercel/og": "^1.0.1",
    "astro": "^7.3.5",
    "browserslist": "^4.29.3",
    "hastscript": "^9.0.1",
    "iso-639-1": "^3.1.6",
    "json5": "^2.2.3",
    "katex": "^0.18.9",
    "lightningcss": "^1.33.0",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "typograf": "^7.8.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@azat-io/eslint-config": "^2.98.0",
    "@azat-io/prettier-config": "^1.3.0",
    "@azat-io/stylelint-config": "^1.14.0",
    "@azat-io/typescript-config": "^1.2.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@cspell/dict-ru_ru": "^2.3.2",
    "@size-limit/file": "^14.1.0",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "cspell": "^10.3.6",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "nano-staged": "^1.0.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "remark-cli": "^12.0.1",
    "remark-lint-code-block-split-list": "^1.0.0",
    "remark-lint-fenced-code-flag": "^4.2.0",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-no-dead-urls": "^2.0.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.1.0",
    "stylelint": "^17.15.0",
    "svelte-check": "^4.7.6",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
